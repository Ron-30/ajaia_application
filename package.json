{
  "name": "ajaia-docs",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight Google Docs-style collaborative document editor (React + TipTap + Express + Postgres).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@vitejs/plugin-react": "^4.7.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "marked": "^15.0.12",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sanitize-html": "^2.18.1",
    "vite": "^6.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
